# 공공데이터포털(data.go.kr) 인증키 — Encoding / Decoding 어느 쪽을 넣어도 됩니다.
#
# KCI 논문 검색(/research) 화면에서만 씁니다. 없어도 나머지 화면은 전부 동작합니다.
# 발급: https://www.data.go.kr/data/15085348/openapi.do 에서 활용신청 (개발계정 자동승인)
#      → 마이페이지 > 데이터활용 > Open API > 인증키 발급현황
VITE_DATAGO_SERVICE_KEY=

# 오픈API 호출 경로. 개발 서버 프록시를 쓰므로 비워두면 됩니다.
# 배포본은 vercel.json 의 리라이트가 같은 역할을 합니다.
VITE_OPENAPI_BASE_URL=
